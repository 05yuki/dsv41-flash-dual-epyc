+
+
+def mxfp4_workspace_nbytes(num_tokens, hidden, inter, num_experts_total, topk, x_dtype,
+                           activation_type, tp_size, tp_rank, ep_size, ep_rank,
+                           use_mxfp8_act_scaling, device, weight_dtype=torch.int64):
