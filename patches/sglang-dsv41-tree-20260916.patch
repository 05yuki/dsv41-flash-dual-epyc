+            # [up; gate] rows, scales become e8m0 bytes and get interleaved.
+            w13_bytes = N * K // 2
+            w13_s = N * (K // 32)
+            w2_bytes = K * N // 2
+            w2_s = K * (N // 32)
+            raw = slot.raw[:, :n]
+            raw_s = slot.raw_s[:, :n]
+            slot.w13_weight[:n, :N].copy_(raw[1, :, :w13_bytes].view(n, N, K // 2))
+            slot.w13_weight[:n, N:].copy_(raw[0, :, :w13_bytes].view(n, N, K // 2))
