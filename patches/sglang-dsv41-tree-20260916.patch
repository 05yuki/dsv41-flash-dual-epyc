+            slot.w13_weight_scale[:n].copy_(block_scale_interleave(s13).reshape_as(s13))
+            slot.w2_weight[:n].copy_(raw[2, :, :w2_bytes].view(n, K, N // 2))
+            s2 = _bf16_to_ue8m0(raw_s[2, :, :4 * w2_s].view(torch.float32).view(n, K, N // 32))
