+#!/usr/bin/env python
+"""Numerical parity for Gemma 4 AVX2 BF16 GeGLU."""
+
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+import pytest
+import torch
+import torch.nn.functional as F
+from kt_kernel import kt_kernel_ext
+
+
+EXPERTS = 4
+HIDDEN = 64
+INTERMEDIATE = 70  # exercises both 8-lane AVX2 and the scalar tail
+TOP_K = 2
+MAX_LEN = 32
+CPU_THREADS = 8
+
+
+def _torch_moe(x, expert_ids, route_weights, gate, up, down, activation="gelu_tanh"):
+    out = torch.zeros((x.shape[0], HIDDEN), dtype=torch.float32)
+    for token_idx in range(x.shape[0]):
+        for route_idx in range(TOP_K):
+            expert = int(expert_ids[token_idx, route_idx])
+            gate_out = x[token_idx].float() @ gate[expert].float().t()
+            up_out = x[token_idx].float() @ up[expert].float().t()
+            if activation == "gelu_tanh":
+                hidden = F.gelu(gate_out, approximate="tanh") * up_out
+            elif activation == "silu":
+                hidden = F.silu(gate_out) * up_out
+            else:
+                raise AssertionError(f"unexpected activation: {activation}")
+            expert_out = hidden @ down[expert].float().t()
+            out[token_idx] += route_weights[token_idx, route_idx] * expert_out
+    return out.to(torch.bfloat16)
+
+
+@pytest.mark.cpu
+@pytest.mark.parametrize("qlen", [1, 13])
+def test_avx2_bf16_gelu_tanh_accuracy(qlen):
+    torch.manual_seed(20260828 + qlen)
+    mapping = torch.arange(EXPERTS, dtype=torch.int64).contiguous()
+    cpu_infer = kt_kernel_ext.CPUInfer(CPU_THREADS)
+
+    gate = (
+        torch.randn(EXPERTS, INTERMEDIATE, HIDDEN) * 0.25
+    ).to(torch.bfloat16).contiguous()
+    up = (
+        torch.randn(EXPERTS, INTERMEDIATE, HIDDEN) * 0.10
+    ).to(torch.bfloat16).contiguous()
+    down = (
+        torch.randn(EXPERTS, HIDDEN, INTERMEDIATE) * 0.10
+    ).to(torch.bfloat16).contiguous()
+
+    config = kt_kernel_ext.moe.MOEConfig(
+        EXPERTS, TOP_K, HIDDEN, INTERMEDIATE, 0
+    )
+    config.max_len = MAX_LEN
+    config.gate_proj = gate.data_ptr()
+    config.up_proj = up.data_ptr()
+    config.down_proj = down.data_ptr()
+    config.gate_scale = 0
+    config.up_scale = 0
+    config.down_scale = 0
+    config.pool = cpu_infer.backend_
+    config.activation_type = 1
+
+    moe = kt_kernel_ext.moe.AVX2BF16_MOE(config)
+    cpu_infer.submit(moe.load_weights_task(mapping.data_ptr()))
+    cpu_infer.sync()
+
+    expert_ids = torch.stack(
+        [torch.randperm(EXPERTS)[:TOP_K] for _ in range(qlen)]
+    ).to(torch.int64).contiguous()
+    route_weights = torch.rand(qlen, TOP_K, dtype=torch.float32).contiguous()
+    # Keep gate values away from zero so a stale SiLU implementation cannot
+    # accidentally pass merely because SiLU(x) and GELU(x) both approach x/2.
+    x = (torch.randn(qlen, HIDDEN) * 0.40).to(torch.bfloat16).contiguous()
+    output = torch.empty(qlen, HIDDEN, dtype=torch.bfloat16).contiguous()
+    batch_size = torch.tensor([qlen], dtype=torch.int32)
+
+    cpu_infer.submit(
+        moe.forward_task(
+            batch_size.data_ptr(),
+            TOP_K,
+            expert_ids.data_ptr(),
+            route_weights.data_ptr(),
+            x.data_ptr(),
+            output.data_ptr(),
+            False,
+        )
+    )
+    cpu_infer.sync()
+
+    reference = _torch_moe(x, expert_ids, route_weights, gate, up, down)
+    silu_reference = _torch_moe(
+        x, expert_ids, route_weights, gate, up, down, activation="silu"
+    )
+    abs_error = (output.float() - reference.float()).abs()
+    rel_l1 = abs_error.mean() / (reference.float().abs().mean() + 1e-8)
+    silu_rel_l1 = (
+        (output.float() - silu_reference.float()).abs().mean()
+        / (reference.float().abs().mean() + 1e-8)
+    )
+    cosine = F.cosine_similarity(
+        output.float().reshape(1, -1), reference.float().reshape(1, -1)
+    ).item()
+
+    assert rel_l1.item() < 0.025, (
+        f"relative L1 error too high: {rel_l1.item():.6f}"
+    )
+    assert cosine > 0.999, f"cosine similarity too low: {cosine:.8f}"
+    assert rel_l1.item() < silu_rel_l1.item() * 0.5, (
+        "output is not materially closer to GeGLU than SiLU: "
+        f"gelu_rel_l1={rel_l1.item():.6f}, silu_rel_l1={silu_rel_l1.item():.6f}"
+    )
+
+
+def test_activation_type_defaults_to_silu():
+    config = kt_kernel_ext.moe.MOEConfig(1, 1, 8, 8, 0)
+    assert config.activation_type == 0
