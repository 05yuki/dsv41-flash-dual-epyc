+// Gemma 4 GeGLU activation:
+//   gelu_pytorch_tanh(gate) * up
+// tanh(z) is evaluated as 2 * sigmoid(2z) - 1 so the existing AVX2 exp
+// approximation can be reused without introducing a scalar lane fallback.
+static inline __m256 gelu_tanh_fn(__m256 gate_val, __m256 up_val) {
+  const __m256 one = _mm256_set1_ps(1.0f);
+  const __m256 two = _mm256_set1_ps(2.0f);
+  const __m256 half = _mm256_set1_ps(0.5f);
+  const __m256 sqrt_two_over_pi = _mm256_set1_ps(0.7978845608028654f);
+  const __m256 cubic_coeff = _mm256_set1_ps(0.044715f);
+
+  const __m256 x2 = _mm256_mul_ps(gate_val, gate_val);
+  const __m256 x3 = _mm256_mul_ps(x2, gate_val);
+  const __m256 inner = _mm256_mul_ps(
+      sqrt_two_over_pi,
+      _mm256_add_ps(gate_val, _mm256_mul_ps(cubic_coeff, x3)));
+
+  __m256 neg_two_inner = _mm256_mul_ps(_mm256_set1_ps(-2.0f), inner);
+  // Outside this interval tanh already rounds to +/-1 at BF16 precision.
+  neg_two_inner = _mm256_max_ps(neg_two_inner, _mm256_set1_ps(-88.0f));
+  neg_two_inner = _mm256_min_ps(neg_two_inner, _mm256_set1_ps(88.0f));
+  const __m256 exp_neg_two_inner = exp_avx2(neg_two_inner);
+  const __m256 tanh_inner = _mm256_sub_ps(
+      _mm256_div_ps(two, _mm256_add_ps(one, exp_neg_two_inner)), one);
+  const __m256 gelu = _mm256_mul_ps(
+      _mm256_mul_ps(half, gate_val), _mm256_add_ps(one, tanh_inner));
+  return _mm256_mul_ps(gelu, up_val);
+}
