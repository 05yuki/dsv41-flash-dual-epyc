+        best_width, best_height = max_w * cell, max_h * cell
+    elif max_h_float < 2.0:
+        max_h = 2
+        max_w = ((max_n_token - 2) // max_h) - 1
+        assert max_w > 1
+        best_width, best_height = max_w * cell, max_h * cell
+    else:
+        max_w = math.floor(max_w_float)
+        max_h = math.floor(max_h_float)
