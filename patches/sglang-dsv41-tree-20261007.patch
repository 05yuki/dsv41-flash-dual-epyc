+            return g["acc"]
+        prof = None
+        if PROFILE and self.calls == PROFILE:
+            from torch.profiler import ProfilerActivity, profile
+
+            prof = profile(activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA])
+            prof.__enter__()
