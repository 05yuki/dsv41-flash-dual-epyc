index 00000000..8e0a4cbd
--- /dev/null
+++ b/python/sglang/srt/models/deepseek_common/wo_a_fp8_gemv.py
@@ -0,0 +1,49 @@
+"""Single-token V4 wo_a from FP8 weights (patches/sglang-dsv4-wo-a-fp8-gemv.py)."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+def fp8_blocks_from_bf16(w: torch.Tensor):
+    """[G, R, D] bf16 -> ([G, R, D] e4m3, [G, R/128, D/128] fp32) by the
+    converter's rule (scale 2^ceil(log2(amax / 448)) per 128x128 block), or
+    None unless it reproduces w exactly."""
+    G, R, D = w.shape
+    if R % 128 or D % 128:
+        return None
+    blocks = w.float().view(G, R // 128, 128, D // 128, 128)
+    amax = blocks.abs().amax(dim=(2, 4))
+    exp = torch.ceil(torch.log2(torch.where(amax > 0, amax / 448.0, torch.ones_like(amax))))
+    exp = torch.where(amax > 0, exp, torch.full_like(exp, -127.0))
+    scale = torch.exp2(exp)
+    q = (blocks / scale[:, :, None, :, None]).to(torch.float8_e4m3fn)
+    back = (q.float() * scale[:, :, None, :, None]).view(G, R, D).to(torch.bfloat16)
+    if not torch.equal(back, w):
+        return None
+    return q.view(G, R, D).contiguous(), scale.contiguous()
+
+
+@triton.jit
+def _wo_a_fp8_gemv_kernel(x_ptr, w_ptr, s_ptr, o_ptr, R, D,
+                          BLOCK_R: tl.constexpr, BLOCK_D: tl.constexpr):
+    g = tl.program_id(0)
+    rb = tl.program_id(1)
+    rows = rb * BLOCK_R + tl.arange(0, BLOCK_R)
+    acc = tl.zeros([BLOCK_R, BLOCK_D], dtype=tl.float32)
+    for d0 in range(0, D, BLOCK_D):
+        cols = d0 + tl.arange(0, BLOCK_D)
+        x = tl.load(x_ptr + g * D + cols).to(tl.float32)
+        w = tl.load(w_ptr + (g * R + rows[:, None]) * D + cols[None, :]).to(tl.float32)
+        s = tl.load(s_ptr + (g * (R // 128) + rows[:, None] // 128) * (D // 128) + cols[None, :] // 128)
+        acc += w * s * x[None, :]
+    tl.store(o_ptr + g * R + rows, tl.sum(acc, axis=1).to(o_ptr.dtype.element_ty))
+
+
+def wo_a_fp8_gemv(o: torch.Tensor, q: torch.Tensor, s: torch.Tensor) -> torch.Tensor:
+    """o [1, G, D] bf16, q [G, R, D] e4m3, s [G, R/128, D/128] -> [1, G, R] bf16."""
+    G, R, D = q.shape
+    x = o.reshape(G, D).contiguous()
+    out = torch.empty((1, G, R), device=o.device, dtype=o.dtype)
+    _wo_a_fp8_gemv_kernel[(G, R // 16)](x, q, s, out, R, D, BLOCK_R=16, BLOCK_D=256, num_warps=4)
+    return out
