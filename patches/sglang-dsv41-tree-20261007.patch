+    vl_weights = vl_weights / vl_weights.sum(-1, keepdim=True)
+    if hash_topk.apply_routed_scaling_factor_on_output:
+        vl_weights = vl_weights * hash_topk.routed_scaling_factor
+    image = (input_ids == moe.config.image_token_id)[:, None]
+    return topk_output._replace(
+        topk_ids=torch.where(image, vl_ids.to(ids.dtype), ids),
+        topk_weights=torch.where(image, vl_weights.to(weights.dtype), weights),
+    )
