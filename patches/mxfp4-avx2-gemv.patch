+    }
+
+    const __m256i lut_lo256 = _mm256_broadcastsi128_si256(lut_lo);
+    const __m256i lut_hi256 = _mm256_broadcastsi128_si256(lut_hi);
+    const __m256i zero256 = _mm256_setzero_si256();
+    const __m128i nib_mask = _mm_set1_epi8(0x0F);
+
